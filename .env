# Server

HOST=0.0.0.0
PORT=1337

# App keys (required)

APP_KEYS=key1,key2,key3,key4

# Admin auth (REQUIRED for your error)

ADMIN_JWT_SECRET=replace-with-a-long-random-string

# API & transfer tokens

API_TOKEN_SALT=replace-with-random-string
TRANSFER_TOKEN_SALT=replace-with-random-string

# Encryption

ENCRYPTION_KEY=replace-with-32-char-or-longer-key

# API JWT

JWT_SECRET=replace-with-another-random-string

# Database (SQLite)

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
